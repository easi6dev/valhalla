#!/bin/bash
set -e

# ==============================================================================
# IMPORTANT: DO NOT EDIT THIS FILE DIRECTLY
# ==============================================================================
# This file is managed from a central 'easi6dev/tada-server-common-source' repository.
# Any changes made here will be overwritten the next time the sync workflow runs.
# To propose changes, submit a PR to the source repository.
# ==============================================================================

# --- ktlint (Kotlin formatting via Gradle) ---
STAGED_KT=$(git diff --cached --name-only --diff-filter=ACM | grep '\.kt$' || true)

if [ -n "$STAGED_KT" ]; then
    echo "Running ktlintFormat on $(echo "$STAGED_KT" | wc -l | tr -d ' ') staged Kotlin file(s)..."
    ./gradlew ktlintFormat -q 2>/dev/null || true
    echo "$STAGED_KT" | xargs git add
    if ! ./gradlew ktlintCheck -q 2>/dev/null; then
        echo "ktlint check failed. Please fix the issues above."
        exit 1
    fi
    echo "ktlint passed."
fi

# --- dprint (YAML formatting) ---
STAGED_YAML=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.ya?ml$' || true)

if [ -n "$STAGED_YAML" ]; then
    if ! command -v npx &> /dev/null; then
        echo "Error: npx not found. Install Node.js to enable YAML formatting."
        exit 1
    else
        echo "Running dprint on $(echo "$STAGED_YAML" | wc -l | tr -d ' ') staged YAML file(s)..."
        echo "$STAGED_YAML" | xargs npx dprint fmt 2>/dev/null || true
        echo "$STAGED_YAML" | xargs git add
        echo "YAML formatting done."
    fi
fi
